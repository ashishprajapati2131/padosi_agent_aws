GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_FIELD_MODE=standard
DATABASE_URL=postgresql+psycopg://places:places@postgres:5432/places
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
MAX_RESULTS_PER_SEARCH=100
MAX_SEARCHES_PER_MINUTE=10
MAX_SEARCHES_PER_MINUTE_IP=20
GOOGLE_API_TIMEOUT=10
GOOGLE_API_MAX_RETRIES=2
SEARCH_RETENTION_DAYS=90
BULK_MAX_ROWS=25
BULK_CONCURRENCY=1
LOG_LEVEL=INFO
ENVIRONMENT=development
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Optional. Comma-separated field keys to drop from storage or export
# without a code change. See docs/compliance.md.
# STORAGE_DISABLED_FIELDS=latitude,longitude
# EXPORT_DISABLED_FIELDS=latitude,longitude
# EXPORT_FIELD_FLAGS={"latitude": false, "longitude": false}
