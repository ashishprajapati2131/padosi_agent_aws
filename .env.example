# Copy to .env and fill in real values. Never commit .env.

DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
# Seconds to wait when opening a MySQL connection before failing (default 10)
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis Cache & Session URL (Leave empty for FileBasedCache fallback, or set to e.g. redis://default:pass@host:port)
REDIS_URL=
SESSION_ENGINE=django.contrib.sessions.backends.cache

BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@padosiagent.com
BREVO_FROM_NAME=PadosiAgent
BREVO_OTP_FALLBACK=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@padosiagent.com
MAIL_FROM_NAME=PadosiAgent

# ─── Razorpay Payment Gateway (Production Live Credentials) ─────────────────
# In production, use your live credentials from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY must start with 'rzp_live_' for real payments (rzp_test_ is test-only).
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Leave unset on localhost: DEBUG uses mock checkout (EMI/netbanking blocked by browser on HTTP localhost).
# Set to 1 only if testing real Razorpay iframe on localhost HTTP (usually still fails — use ngrok HTTPS instead).
RAZORPAY_ALLOW_LOCALHOST=

FCM_API_KEY=
FCM_AUTH_DOMAIN=
FCM_PROJECT_ID=
FCM_STORAGE_BUCKET=
FCM_MESSAGING_SENDER_ID=
FCM_APP_ID=
FCM_VAPID_KEY=
FCM_SERVICE_ACCOUNT_JSON=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GBP_REDIRECT_URI=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

JWT_SECRET_KEY=
ADMIN_WHITELIST_IPS=
ALLOWED_CORS_ORIGINS=http://localhost:3000
SECURITY_ALERT_EMAIL=
# ─── Error Tracking & APM (Sentry) ──────────────────────────────────────────
# Create a Django project on sentry.io and paste your DSN here.
# Format: https://<public_key>@o<org_id>.ingest.sentry.io/<project_id>
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Base application URL (http://localhost:8000 for local dev, https://padosiagent.com in production)
APP_URL=https://padosiagent.com

# IndexNow (Bing/Yandex): 32 hex chars, e.g. python -c "import secrets;print(secrets.token_hex(16))"
# Served at https://padosiagent.com/<key>.txt; submit URLs with: python manage.py indexnow_ping
INDEXNOW_KEY=

# Cloudinary Storage (for agent photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chatbot LLM Providers (Groq, Gemini, OpenRouter)
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# LLM spend caps (per calendar day, counted in the shared cache)
# Chatbot messages per visitor IP (default 100) and across all visitors (default 5000).
CHATBOT_DAILY_IP_LIMIT=100
CHATBOT_DAILY_GLOBAL_LIMIT=5000
# AI bio generations per agent (default 10).
BIO_DAILY_AGENT_LIMIT=10

# ─── WhatsApp Agent Bot Configuration ──────────────────────────────────────
# Enable or disable the WhatsApp Agent bot
WA_BOT_ENABLED=true
# OpenWA NestJS base URL (defaults to http://localhost:3000)
WA_BOT_OPENWA_BASE_URL=http://localhost:3000
# OpenWA Session ID
WA_BOT_OPENWA_SESSION_ID=default
# OpenWA API Key (if configured in OpenWA)
WA_BOT_OPENWA_API_KEY=
# Public website URL for login links (e.g. https://padosiagent.com or http://localhost:8000)
# Optional: site origin for links in WhatsApp messages. Defaults to APP_URL; localhost is ignored when DEBUG=False.
WA_BOT_SITE_URL=
# HMAC secret for validating incoming webhook payloads (optional for local dev)
# Required in production: inbound bot webhooks are rejected without it. Re-run Admin > WhatsApp > Sync Webhook after setting.
WA_BOT_WEBHOOK_SECRET=
# Must equal the SYNC_TOKEN Script Property of the invoice Google Apps Script web app.
INVOICE_SHEET_SYNC_TOKEN=

