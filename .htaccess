# ==============================================================================
# PadosiAgent Production Server Security Policy (.htaccess)
# ==============================================================================

# Disable directory listing
Options -Indexes

# 1. Deny access to hidden files and directories (dot-files like .git, .env)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to git repository metadata
    RewriteRule ^\.git - [F,L]
    
    # Block access to backups and logs directories
    RewriteRule ^backups/ - [F,L]
    RewriteRule ^logs/ - [F,L]
</IfModule>

# 2. Deny direct web access to sensitive environment files, secrets, and configurations
<FilesMatch "^(\.env|\.env\..*|\.git.*|\.jwt_secret|requirements\.txt|manage\.py|passenger_wsgi\.py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Disable HTTP methods other than GET, POST, HEAD, OPTIONS, PUT, DELETE
<LimitExcept GET POST HEAD OPTIONS PUT DELETE>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</LimitExcept>

